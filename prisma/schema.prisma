generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

////////////////////////
// USER & AUTH
////////////////////////

model User {
  id               Int               @id @default(autoincrement())
  email            String?           @unique
  name             String?
  hashedPassword   String?
  emailVerified    DateTime?
  createdAt        DateTime          @default(now())

  dietResponses    DietResponse[]
  workoutResponses WorkoutResponse[]
  plans            Plan[]
  accounts         Account[]
  sessions         Session[]
}

model Account {
  id                Int       @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

////////////////////////
// QUESTIONNAIRES
////////////////////////

model DietResponse {
  id               Int           @id @default(autoincrement())
  userId           Int?
  age              Int
  gender           Gender
  currentWeightKg  Float
  heightCm         Int
  activityLevel    ActivityLevel
  goal             GoalType
  dietPreference   DietType
  mealFrequency    Int           @default(4)
  foodRestrictions String?
  createdAt        DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model WorkoutResponse {
  id           Int          @id @default(autoincrement())
  userId       Int?
  gender       Gender
  fitnessLevel FitnessLevel
  goal         GoalType
  location     String
  workoutTypes Json
  workoutDays  String
  createdAt    DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])
}

////////////////////////
// MEAL BLOCK ENGINE
////////////////////////

model Meal {
  id                     Int       @id @default(autoincrement())

  title                  String
  mealType               MealType
  goal                   GoalType
  dietType               DietType

  dailyCalorieBracketMin Int
  dailyCalorieBracketMax Int

  calories               Int        // kcal are whole numbers
  proteinG               Float      // grams can be decimal
  carbsG                 Float
  fatG                   Float

  ingredients             String
  isPublished             Boolean   @default(true)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([mealType, goal, dietType])
  @@index([dailyCalorieBracketMin, dailyCalorieBracketMax])
}


////////////////////////
// PLAN SNAPSHOTS
////////////////////////

model Plan {
  id          Int      @id @default(autoincrement())
  userId      Int?
  type        String   // DIET | WORKOUT
  title       String?
  payload     Json
  generatedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

////////////////////////
// WORKOUT EXERCISES
////////////////////////

model Exercise {
  id           Int      @id @default(autoincrement())
  name         String
  muscleGroup  String
  equipment    String
  difficulty   String
  instructions String?
  repsTemplate String?
  createdAt    DateTime @default(now())
}

model ExerciseBlock {
  id            Int      @id @default(autoincrement())

  name          String
  muscleGroup   String

  goal          GoalType
  fitnessLevel  FitnessLevel
  location      WorkoutLocation
  workoutType   WorkoutType

  equipment     String
  sets          Int
  repsOrTime    String
  restSec       Int

  notes         String?
  isPublished   Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([goal, fitnessLevel, location])
  @@index([workoutType])
}


////////////////////////
// ENUMS (STRICT)
////////////////////////

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  SUPER_ACTIVE
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum GoalType {
  WEIGHT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
  ENDURANCE
}

enum DietType {
  VEG
  NON_VEG
}

enum WorkoutLocation {
  HOME
  GYM
}

enum WorkoutType {
  STRENGTH
  CARDIO
  HIIT
  BODYWEIGHT
}
